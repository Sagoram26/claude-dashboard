{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist/server",
    "rootDir": "server",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "rewriteRelativeImportExtensions": true
  },
  "include": ["server"]
}
